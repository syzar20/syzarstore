<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="AVG Ultimate - 1 Year"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#111827" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Multi-device • Real-time protection • VPN included"
            android:textSize="13sp"
            android:textColor="#374151"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:src="@drawable/defender"
                android:contentDescription="AVG Ultimate"
                android:scaleType="centerInside"
                android:background="#F3F4F6"
                android:padding="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Price: $14.99"
                android:textStyle="bold"
                android:textColor="#0B8F6A"
                android:textSize="18sp"
                android:layout_marginTop="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Features"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Real‑time malware, ransomware  phishing protection"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginTop="6dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Unlimited devices (Windows/Mac/Android)"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Premium VPN + TuneUp utilities"
                android:textColor="#374151"
                android:textSize="14sp"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="All-in-one security suite to keep your devices fast, private and protected."
                android:textColor="#111827"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginTop="12dp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_back_products"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:text="Back to Products"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:background="@color/blue"
            />


    </LinearLayout>
</LinearLayout>
