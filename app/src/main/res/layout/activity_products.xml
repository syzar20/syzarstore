<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    android:background="@color/white"
    android:padding="16dp">


    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/storeTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SyzarSoft Store"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/storeSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Original Keys • Best Prices"
            android:textColor="#374151"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/scrollProducts"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/productsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:showDividers="middle"
            android:divider="@android:drawable/divider_horizontal_bright"
            android:dividerPadding="8dp">

            <LinearLayout
                android:id="@+id/item_windows11"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/img_windows11"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/windows"
                        android:contentDescription="Windows 11 Pro"
                        android:scaleType="centerCrop"
                        android:background="#F3F4F6"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/title_windows11"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp"
                            android:text="Windows 11 Pro - Genuine Key"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/desc_windows11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant Activation • 1 Device"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/price_windows11"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: $19.99"
                            android:textColor="#0B8F6A"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_fav_windows11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@null"
                        android:text="Add to Favorites"
                        android:textAllCaps="false"
                        android:textColor="@color/blue" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_buy_windows11"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Buy Now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:background="#2563EB" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/item_office2021"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/img_office2024"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/office2"
                        android:contentDescription="Office 2024 Pro Plus"
                        android:scaleType="centerCrop"
                        android:background="#F3F4F6"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/title_office2024"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp"
                            android:text="Office 2024 Pro Plus - Lifetime Key"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/desc_office2024"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Word • Excel • PowerPoint"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/price_office2021"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: $24.99"
                            android:textColor="#0B8F6A"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_fav_office2024"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="?attr/selectableItemBackground"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@null"
                        android:text="Add to Favorites"
                        android:textAllCaps="false"
                        android:textColor="@color/blue" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_buy_office2024"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Buy Now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:background="#2563EB" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/item_kaspersky"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/img_avg"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/defender"
                        android:contentDescription="AVG Ultimate"
                        android:scaleType="centerCrop"
                        android:background="#F3F4F6"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/title_avg"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp"
                            android:text="AVG Ultimate - 1 Year"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/desc_avg"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Multi-device Protection"
                            android:textColor="#374151"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/price_kaspersky"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: $14.99"
                            android:textColor="#0B8F6A"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_fav_avg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Add to Favorites"
                        android:textAllCaps="false"
                        android:textColor="@color/blue"
                        android:background="?attr/selectableItemBackground"
                        android:stateListAnimator="@null" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_buy_avg"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Buy Now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:background="#2563EB" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/item_m365"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:background="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="top">

                    <ImageView
                        android:id="@+id/img_win10"
                        android:layout_width="84dp"
                        android:layout_height="84dp"
                        android:src="@drawable/windows2"
                        android:contentDescription="Windows 10 Pro"
                        android:scaleType="centerCrop"
                        android:background="#F3F4F6"
                        android:padding="8dp"
                        android:clickable="true"
                        android:focusable="true" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:id="@+id/title_windows10"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:paddingVertical="8dp"
                            android:text="Windows 10 Pro - Genuine Key"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                        <TextView
                            android:id="@+id/desc_windows10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Instant Activation • 1 Device"
                            android:textColor="#374151"
                            android:textSize="13sp"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/price_windows10"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Price: $29.99"
                            android:textColor="#0B8F6A"
                            android:textStyle="bold"
                            android:textSize="16sp"
                            android:layout_marginTop="8dp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/btn_fav_windows10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Add to Favorites"
                        android:textAllCaps="false"
                        android:textColor="@color/blue"
                        android:background="?attr/selectableItemBackground"
                        android:stateListAnimator="@null" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_buy_windows10"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:paddingHorizontal="12dp"
                        android:layout_weight="1"
                        android:text="Buy Now"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:background="#2563EB" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/top_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="end"
        android:gravity="end"
        android:paddingTop="4dp">

        <ImageView
            android:id="@+id/icon_help"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_help"
            android:contentDescription="FAQ . Support"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />

        <Space
            android:layout_width="4dp"
            android:layout_height="1dp" />

        <ImageView
            android:id="@+id/icon_info"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@android:drawable/ic_menu_info_details"
            android:contentDescription="About"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>



</LinearLayout>