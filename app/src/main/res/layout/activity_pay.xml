<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/tv_checkout_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Checkout"
            android:textColor="#111827"
            android:textStyle="bold"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/tv_checkout_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure payment • SSL encrypted"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>


    <ScrollView
        android:id="@+id/scroll_checkout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <LinearLayout
                android:id="@+id/card_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F9FAFB"
                android:padding="12dp"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tv_summary_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Order Summary"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">



                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="8dp"
                    android:background="#E5E7EB" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <EditText
                        android:id="@+id/et_promo"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="Promo code (optional)"
                        android:paddingHorizontal="12dp"
                        android:background="@android:drawable/edit_text"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:inputType="textCapCharacters" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <Button
                        android:id="@+id/btn_apply_promo"
                        android:layout_width="100dp"
                        android:layout_height="48dp"
                        android:text="Apply"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:background="#2563EB" />
                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/card_method"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_method_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Payment Method"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <RadioGroup
                    android:id="@+id/rg_methods"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <RadioButton
                        android:id="@+id/rb_card"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:text="Credit / Debit Card (Visa, MasterCard)"
                        android:textColor="#111827"
                        android:buttonTint="#2563EB" />

                    <RadioButton
                        android:id="@+id/rb_paypal"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:text="PayPal"
                        android:textColor="#111827"
                        android:buttonTint="#2563EB" />

                    <RadioButton
                        android:id="@+id/rb_cod"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:gravity="center_vertical"
                        android:text="Other method / Manual transfer"
                        android:textColor="#111827"
                        android:buttonTint="#2563EB" />
                </RadioGroup>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/card_card_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F9FAFB"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_card_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Card Details"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_card_name"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="Name on card"
                    android:paddingHorizontal="12dp"
                    android:background="@android:drawable/edit_text"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:inputType="textPersonName"
                    android:importantForAutofill="yes"
                    android:autofillHints="name" />

                <EditText
                    android:id="@+id/et_card_number"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="Card number"
                    android:paddingHorizontal="12dp"
                    android:background="@android:drawable/edit_text"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:inputType="number"
                    android:maxLength="19"
                    android:importantForAutofill="yes"
                    android:autofillHints="creditCardNumber" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <EditText
                        android:id="@+id/et_card_expiry"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="MM/YY"
                        android:paddingHorizontal="12dp"
                        android:background="@android:drawable/edit_text"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:inputType="number"
                        android:maxLength="5"
                        android:importantForAutofill="yes"
                        android:autofillHints="creditCardExpirationDate" />

                    <Space
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <EditText
                        android:id="@+id/et_card_cvv"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:hint="CVV"
                        android:paddingHorizontal="12dp"
                        android:background="@android:drawable/edit_text"
                        android:textColor="#111827"
                        android:textColorHint="#9CA3AF"
                        android:inputType="numberPassword"
                        android:maxLength="4"
                        android:importantForAutofill="yes"
                        android:autofillHints="creditCardSecurityCode" />
                </LinearLayout>

                <CheckBox
                    android:id="@+id/cb_save_card"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:text="Save card for next time"
                    android:textColor="#374151"
                    android:buttonTint="#2563EB" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/card_billing"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#FFFFFF"
                android:padding="12dp"
                android:layout_marginTop="12dp">

                <TextView
                    android:id="@+id/tv_billing_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billing Info (optional)"
                    android:textStyle="bold"
                    android:textColor="#111827"
                    android:textSize="16sp" />

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="Email for receipt"
                    android:paddingHorizontal="12dp"
                    android:background="@android:drawable/edit_text"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/et_country"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:hint="Country"
                    android:paddingHorizontal="12dp"
                    android:background="@android:drawable/edit_text"
                    android:textColor="#111827"
                    android:textColorHint="#9CA3AF"
                    android:inputType="textCapWords" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>


    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="8dp">



        <LinearLayout
            android:id="@+id/actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/btn_back_to_products"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Back to Products"
                android:textAllCaps="false"
                android:textColor="#2563EB"
                android:background="?attr/selectableItemBackground"
                android:stateListAnimator="@null" />

            <Space
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <Button
                android:id="@+id/btn_pay_now"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="Pay Now"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:background="#2563EB" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
